<Project Sdk="Microsoft.NET.Sdk">
  <!-- BCL yuzey envanteri: derlenmis DLL'lerin System.* referanslarini corelib kaynagiyla
       karsilastirir (bkz. BclSurvey.cs). Kullanim (aotcompiler/ dizininden):
         dotnet run - -project tools/bclsurvey - - c_runtime/corelib ../player/bin/Release/net9.0/DigitoyEngine.dll ../player/bin/Release/net9.0/DigitoyPlayer.dll [obj/player-c/diag.txt]
       ('- -' = cift tire; XML yorumunda yazilamaz) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>bclsurvey</AssemblyName>
  </PropertyGroup>
</Project>
