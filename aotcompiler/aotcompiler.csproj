<Project Sdk="Microsoft.NET.Sdk">

  <!-- DigitoyEngine AOT derleyicisi (host araci): derlenmis .NET assembly'lerini CIL
       frontend ile IR'a yukler, corelib ile C'ye transpile eder, clang ile native exe
       uretir. Calisma dizini = bu klasor (c_runtime/ goreli yollari). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>aotcompiler</AssemblyName>
    <RootNamespace>DigitoyEngine</RootNamespace>
    <StartupObject>Program</StartupObject>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- corelib ayri projedir (corelib/Digitoy.CoreLib.csproj, NoStdLib); bu projeye girmez -->
    <Compile Remove="c_runtime\**\*.cs" />
    <!-- yardimci IL dump araci ayri projedir -->
    <Compile Remove="tools\**\*.cs" />
    <!-- selftest ayri host projesiyle derlenir (Main cakismasi) -->
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="obj\**\*.cs" />
  </ItemGroup>

</Project>
