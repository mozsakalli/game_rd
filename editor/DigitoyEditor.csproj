<Project Sdk="Microsoft.NET.Sdk">

  <!-- DigitoyEditor: gercek editor uygulamasi (exe). Motoru referanslar; bir
       PROJE klasoru acar (Projects/Sandbox gibi), sahneyi doc olarak yukler,
       Ctrl+S = kaydet + full reload. Oyun kodu Assets/**/*.cs'ten derlenip
       collectible ALC ile yuklenecek (Editor/ klasoru editor assembly'sine). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>DigitoyEditor</AssemblyName>
    <DefineConstants>$(DefineConstants);DE_EDITOR</DefineConstants>
  </PropertyGroup>

  <!-- Grafik backend'i DERLEME zamani secilir (runtime degil). Varsayilan:
       macOS=Metal, diger=OpenGL. Override: dotnet build -p:Renderer=OpenGL
       (bu ozellik ProjectReference ile engine projesine de gecer). -->
  <PropertyGroup>
    <Renderer Condition="'$(Renderer)' == '' AND '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">Metal</Renderer>
    <Renderer Condition="'$(Renderer)' == ''">OpenGL</Renderer>
    <DefineConstants Condition="'$(Renderer)' == 'Metal'">$(DefineConstants);DE_RENDERER_METAL</DefineConstants>
    <DefineConstants Condition="'$(Renderer)' == 'OpenGL'">$(DefineConstants);DE_RENDERER_OPENGL</DefineConstants>
  </PropertyGroup>


  <ItemGroup>
    <ProjectReference Include="..\engine\managed\DigitoyEngine.csproj" />
    <!-- Registry in-memory derleme (CatalogWriter ciktisi): MSBuild subprocess yok. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <!-- Ortak in-process Roslyn derleyicisi (aotcompiler ile AYNI dosya): oyun kodu hot-reload -->
    <Compile Include="..\aotcompiler\source\RoslynCompiler.cs" Link="Build\RoslynCompiler.cs" />
    <!-- Plugin DLL'lerinin System.* referanslari icin corelib facade'leri (AotCompatCheck, aotcompiler ile AYNI dosya) -->
    <Compile Include="..\aotcompiler\source\FacadeBuilder.cs" Link="Build\FacadeBuilder.cs" />
    <!-- Dev modda AOT IL'ini (corelib + engine) tazeleyen ortak derleyici (AotCompatCheck bayat referansla denetlemesin; aotcompiler ile AYNI dosya) -->
    <Compile Include="..\aotcompiler\source\AotIl.cs" Link="Build\AotIl.cs" />
    <!-- Plugin kanca API'si: aotcompiler ile AYNI assembly (kopya degil) -> kullanici Editor/ kodu tek tip kimligi gorur -->
    <ProjectReference Include="..\aotcompiler\hooks\DigitoyEngine.Build.csproj" />
    <!-- Library paneli baslangic elemanlari (prefab YAML): proje Assets/Library bosken kopyalanir. -->
    <EmbeddedResource Include="Resources\Library\*.prefab" LogicalName="Library/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Native motor kutuphanesi cikti klasorune kopyalanir (P/Invoke burada arar). -->
  <ItemGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">
    <None Include="..\engine\native\build\libdigitoyengine_native.dylib"
          Condition="Exists('..\engine\native\build\libdigitoyengine_native.dylib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libdigitoyengine_native.dylib</Link>
    </None>
  </ItemGroup>
  <ItemGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">
    <None Include="..\engine\native\build\digitoyengine_native.dll"
          Condition="Exists('..\engine\native\build\digitoyengine_native.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>digitoyengine_native.dll</Link>
    </None>
  </ItemGroup>

</Project>
