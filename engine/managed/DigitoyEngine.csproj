<Project Sdk="Microsoft.NET.Sdk">

  <!-- DigitoyEngine runtime cekirdegi (LIBRARY). Editor (DigitoyEditor.csproj) ve
       oyun player'lari bunu referanslar. langtest 'engine' build modu bu DLL'i CIL
       frontend ile IR'a yukler, C'ye transpile eder ve native host + sokol ile linkler. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>DigitoyEngine</AssemblyName>
  </PropertyGroup>

  <!-- Editor/debug altyapisi yalniz Debug'da derlenir; Release'e tek satir girmez. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DE_EDITOR</DefineConstants>
  </PropertyGroup>

  <!-- Grafik backend'i DERLEME zamani secilir (runtime degil). Varsayilan:
       macOS=Metal, diger=OpenGL. Override: dotnet build -p:Renderer=OpenGL
       (macOS'ta OpenGL derlemek icin). Native lib de ayni backend'le
       derlenmeli (build_editor.sh: -DSOKOL_METAL / -DSOKOL_GLCORE). -->
  <PropertyGroup>
    <Renderer Condition="'$(Renderer)' == '' AND '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">Metal</Renderer>
    <Renderer Condition="'$(Renderer)' == ''">OpenGL</Renderer>
    <DefineConstants Condition="'$(Renderer)' == 'Metal'">$(DefineConstants);DE_RENDERER_METAL</DefineConstants>
    <DefineConstants Condition="'$(Renderer)' == 'OpenGL'">$(DefineConstants);DE_RENDERER_OPENGL</DefineConstants>
  </PropertyGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="DigitoyEditor" />
    <!-- Uretilen katalog kaydi (CatalogWriter ciktisi) internal tip/alanlara erisebilsin. -->
    <InternalsVisibleTo Include="Digitoy.Registry" />
  </ItemGroup>

  <!-- build_editor.cmd ciktisi native lib'i cikti yanina kopyala (referanslayan
       exe'lere transitif tasinir; DllImport bulur). -->
  <ItemGroup>
    <None Include="..\native\build\digitoyengine_native.dll"
          Link="digitoyengine_native.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
