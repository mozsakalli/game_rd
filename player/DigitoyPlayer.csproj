<Project Sdk="Microsoft.NET.Sdk">

  <!-- DigitoyPlayer: .NET DEV HOST (docs/platform-hosts.md). GLFW pencere acar, DigitoyEngine.GameHost'u
       surer; editorsuz hizli test. Proje kokunden Build/game.pak (yoksa Debug'da loose Assets/) +
       Library/Build'deki <Ad>.Game.dll & Digitoy.Registry.dll ile sahneyi acar.
       RELEASE/AOT URUNU BU PROJEDEN CIKMAZ: aotcompiler 'player' modu engine + oyun kodunu Roslyn ile
       derleyip C'ye cevirir, c_runtime/host_desktop.c ile linkler. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>DigitoyPlayer</AssemblyName>
  </PropertyGroup>

  <!-- Grafik backend'i derleme zamani (editor csproj ile ayni desen). -->
  <PropertyGroup>
    <Renderer Condition="'$(Renderer)' == '' AND '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">Metal</Renderer>
    <Renderer Condition="'$(Renderer)' == ''">OpenGL</Renderer>
    <DefineConstants Condition="'$(Renderer)' == 'Metal'">$(DefineConstants);DE_RENDERER_METAL</DefineConstants>
    <DefineConstants Condition="'$(Renderer)' == 'OpenGL'">$(DefineConstants);DE_RENDERER_OPENGL</DefineConstants>
  </PropertyGroup>

  <!-- Debug: engine ile ayni DE_EDITOR - loose Assets/ + YAML sahne yolu acik. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DE_EDITOR</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\engine\managed\DigitoyEngine.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">
    <None Include="..\engine\native\build\digitoyengine_native.dll"
          Condition="Exists('..\engine\native\build\digitoyengine_native.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>digitoyengine_native.dll</Link>
    </None>
  </ItemGroup>

</Project>
