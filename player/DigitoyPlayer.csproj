<Project Sdk="Microsoft.NET.Sdk">

  <!-- DigitoyPlayer: standalone runtime host (release yolu). Editor YOK: proje
       kokunden project.yaml + Build/game.pak (yoksa loose Assets/ fallback) +
       Library/Build'deki Game.dll & Digitoy.Registry.dll (editorun urettigi
       katalog kaydi) ile sahneyi acar ve kosar. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>DigitoyPlayer</AssemblyName>
  </PropertyGroup>

  <!-- Grafik backend'i derleme zamani (editor csproj ile ayni desen). -->
  <PropertyGroup>
    <Renderer Condition="'$(Renderer)' == '' AND '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">Metal</Renderer>
    <Renderer Condition="'$(Renderer)' == ''">OpenGL</Renderer>
    <DefineConstants Condition="'$(Renderer)' == 'Metal'">$(DefineConstants);DE_RENDERER_METAL</DefineConstants>
    <DefineConstants Condition="'$(Renderer)' == 'OpenGL'">$(DefineConstants);DE_RENDERER_OPENGL</DefineConstants>
  </PropertyGroup>

  <!-- Dev (Debug): engine ile ayni DE_EDITOR — loose Assets/ + YAML sahne yolu acik.
       Release'te yalniz pak + baked + async yol derlenir. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DE_EDITOR</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\engine\managed\DigitoyEngine.csproj" />
  </ItemGroup>

  <!-- AOT/release: -p:GameProject=<proje koku> verilince uretilmis registry
       (Library/Build/Registry.g.cs) + oyun scriptleri (Assets/Scripts) bu assembly'ye
       GOMULUR ve DE_AOT tanimlanir: Assembly.LoadFrom yok, katalog dogrudan
       Registry.RegisterAll ile kurulur. aotcompiler 'player' modu bu DLL'i C'ye cevirir. -->
  <PropertyGroup Condition="'$(GameProject)' != ''">
    <DefineConstants>$(DefineConstants);DE_AOT</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(GameProject)' != ''">
    <Compile Include="$(GameProject)\Library\Build\Registry.g.cs" Link="Game\Registry.g.cs" />
    <Compile Include="$(GameProject)\Assets\Scripts\**\*.cs" Link="Game\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">
    <None Include="..\engine\native\build\digitoyengine_native.dll"
          Condition="Exists('..\engine\native\build\digitoyengine_native.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>digitoyengine_native.dll</Link>
    </None>
  </ItemGroup>

</Project>
