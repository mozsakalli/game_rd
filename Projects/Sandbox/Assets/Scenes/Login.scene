scene: Main
objects:
  - id: 1
    parent: 0
    name: BG
    pos: 0 0 0
    rot: 0 0 0
    scale: 1 1 1
    components:
      - type: LayoutBox
        fitScreen: true
        fillColor: '#0e1e4eff'
        fillColor2: '#3f7fd9ff'
        gradient: true
  - id: 2
    parent: 1
    name: Logo
    pos: 0 0 0
    rot: 0 0 0
    scale: 1 1 1
    components:
      - type: LayoutBox
        width: 220
        height: 90
        anchorMin: 0.5 0
        anchorMax: 0.5 0
        pivot: 0.5 0
        anchoredPos: 0 48
        fillColor: '#ffffffe6'
        radiusTL: 18
        radiusTR: 18
        radiusBR: 18
        radiusBL: 18
  - id: 3
    parent: 1
    name: ButtonRow
    pos: 0 0 0
    rot: 0 0 0
    scale: 1 1 1
    components:
      - type: LayoutBox
        layout: Horizontal
        spacing: 14
        alignChildren: Center
        anchorMin: 0.5 0.5
        anchorMax: 0.5 0.5
        pivot: 0.5 0.5
  - id: 4
    parent: 3
    name: FacebookLogin
    pos: 0 0 0
    rot: 0 0 0
    scale: 1 1 1
    components:
      - type: LayoutBox
        width: 150
        height: 46
        fillColor: '#1877f2ff'
        radiusTL: 10
        radiusTR: 10
        radiusBR: 10
        radiusBL: 10
  - id: 5
    parent: 3
    name: GuestLogin
    pos: 0 0 0
    rot: 0 0 0
    scale: 1 1 1
    components:
      - type: LayoutBox
        width: 150
        height: 46
        fillColor: '#6b7280ff'
        radiusTL: 10
        radiusTR: 10
        radiusBR: 10
        radiusBL: 10
  - id: 6
    parent: 3
    name: AppleLogin
    pos: 0 0 0
    rot: 0 0 0
    scale: 1 1 1
    components:
      - type: LayoutBox
        width: 150
        height: 46
        fillColor: '#0a0a0aff'
        borderLeft: 1
        borderTop: 1
        borderRight: 1
        borderBottom: 1
        borderColor: '#ffffff80'
        radiusTL: 10
        radiusTR: 10
        radiusBR: 10
        radiusBL: 10
      - type: ApplePlatformOnly
  - id: 7
    parent: 1
    name: Copyright
    pos: 0 0 0
    rot: 0 0 0
    scale: 1 1 1
    components:
      - type: LayoutBox
        width: 280
        height: 14
        anchorMin: 0.5 1
        anchorMax: 0.5 1
        pivot: 0.5 1
        anchoredPos: 0 -20
        fillColor: '#ffffff59'
        radiusTL: 7
        radiusTR: 7
        radiusBR: 7
        radiusBL: 7
