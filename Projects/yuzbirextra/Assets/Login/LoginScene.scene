scene: Main
objects:
  - id: 2
    parent: 0
    name: CAMERA
    pos: 0 0 -3000
    rot: 0 0 0
    scale: 1 1 1
    components:
      - type: CameraComponent
        projection: Perspective
        fov: 30
      - type: CameraScaler
        camera: '2:CameraComponent:0'
        referenceResolution: 1440 960
  - id: 1
    parent: 0
    name: ROOT
    pos: 0 0 0
    rot: 0 0 0
    scale: 1 1 1
    components:
      - type: LayoutBox
        sprite: a3bbb7fee0894f42a91174631cedb195
        fitScreen: true
        width: 1440
        height: 960
        borderFill:
          type: Solid
          direction: Vertical
          color: '#ffffffff'
          color2: '#00000000'
        border: 1 1 1 1
      - type: MovieClip
        Fps: 60
        FrameCount: 96
        PlayOnStart: true
        Loop: false
        Tracks:
          - Keys:
              - Frame: 0
                Value: 1 1 1 0
              - Ease: OutQuad
                Frame: 18
                Value: 1 1 1 0
              - Ease: InOutSine
                Frame: 22
                Value: 1.05 1.05 1 0
              - Frame: 34
                Value: 1 1 1 0
            Path: Scale
            Target: '11:Transform:0'
          - Keys:
              - Ease: InSine
                Frame: 0
                Value: 0.3 0.3 1 0
              - Ease: OutExpo
                Frame: 18
                Value: 0.6 0.6 1 0
              - Frame: 42
                Value: 2 2 1 0
            Path: Scale
            Target: '8:Transform:0'
          - Keys:
              - Ease: InCubic
                Frame: 0
                Value: 2 2 1 0
              - Ease: OutQuad
                Frame: 18
                Value: 0.94 0.94 1 0
              - Frame: 26
                Value: 1 1 1 0
            Path: Scale
            Target: '12:Transform:0'
          - Keys:
              - Frame: 0
                Mode: Hold
                Value: 0 0 1 0
              - Ease: OutBack
                Frame: 34
                Value: 0 0 1 0
              - Frame: 54
                Value: 1 1 1 0
            Path: Scale
            Target: '3:Transform:0'
          - Keys:
              - Frame: 0
                Mode: Hold
                Value: 0 0 1 0
              - Ease: OutBack
                Frame: 40
                Value: 0 0 1 0
              - Frame: 60
                Value: 1 1 1 0
            Path: Scale
            Target: '5:Transform:0'
          - Keys:
              - Frame: 0
                Mode: Hold
                Value: 0 0 1 0
              - Ease: OutBack
                Frame: 46
                Value: 0 0 1 0
              - Frame: 66
                Value: 1 1 1 0
            Path: Scale
            Target: '6:Transform:0'
          - Keys:
              - Frame: 0
                Mode: Hold
                Value: 0 0 1 0
              - Ease: OutBack
                Frame: 52
                Value: 0 0 1 0
              - Frame: 72
                Value: 1 1 1 0
            Path: Scale
            Target: '7:Transform:0'
          - Target: '10:RenderGroup:0'
            Path: Alpha
            Mask: 15
            Keys:
              - Frame: 0
                Mode: Hold
                Ease: Linear
                Value: 0
                Ref: ''
              - Frame: 60
                Mode: Tween
                Ease: OutSine
                Value: 0
                Ref: ''
              - Frame: 84
                Mode: Tween
                Ease: Linear
                Value: 1
                Ref: ''
