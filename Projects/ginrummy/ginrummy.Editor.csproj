<!-- DigitoyEditor tarafindan uretilir; elle duzenleme bir sonraki acilista ezilir. -->
<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>Library/IdeBuild/obj-editor/</BaseIntermediateOutputPath>
    <BaseOutputPath>Library/IdeBuild/bin-editor/</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>ginrummy.Editor</AssemblyName>
    <RootNamespace></RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>DEBUG;TRACE;DE_EDITOR;DE_GAME</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Assets/**/Editor/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="ginrummy.Game.csproj" Private="false" />
    <Reference Include="DigitoyEngine">
      <HintPath>C:\Work\digitoygames\game_rd\editor\bin\Debug\net10.0\DigitoyEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DigitoyEditor">
      <HintPath>C:\Work\digitoygames\game_rd\editor\bin\Debug\net10.0\DigitoyEditor.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DigitoyEngine.Build">
      <HintPath>C:\Work\digitoygames\game_rd\editor\bin\Debug\net10.0\DigitoyEngine.Build.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assets/**/*.dll" Private="false" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
