                Ease: Linear
                Value: 1 1 1 0
                Ref: ''
              - Frame: 3
                Mode: Tween
                Ease: Linear
                Value: 0.5 0.5 1 0
                Ref: ''
          - Target: '53:RenderGroup:0'
