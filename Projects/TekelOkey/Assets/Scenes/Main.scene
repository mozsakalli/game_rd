        Tracks:
          - Target: '53:Transform:0'
            Path: Scale
            Mask: 15
            Keys:
              - Frame: 0
                Mode: Tween
                Ease: OutBack
                Value: 0.5 0.5 1 0
                Ref: ''
              - Frame: 12
                Mode: Tween
                Ease: Linear
                Value: 1 1 1 0
                Ref: ''
          - Target: '53:RenderGroup:0'
            Path: Alpha
            Mask: 15
            Keys:
              - Frame: 0
                Mode: Tween
                Ease: Linear
                Value: 0 0 0 0
                Ref: ''
              - Frame: 0
                Mode: Tween
                Ease: Linear
                Value: 1 0 0 0
                Ref: ''
        FrameCount: 12
